<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- ⚡ Element1 V2 - 高效版本 -->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.acard.acard.ui.Element1ControllerV2"
           style="-fx-background-color: #1F1F1F;">
    <children>
        <ScrollPane fx:id="scroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                    style="-fx-background-color: #1F1F1F; -fx-background: #1F1F1F; -fx-border-color: transparent; -fx-border-width: 0;">
            <content>
                <GridPane fx:id="grid" 
                          hgap="2" 
                          vgap="2" 
                          style="-fx-background-color: #1F1F1F; -fx-padding: 2;"/>
            </content>
        </ScrollPane>
    </children>
</StackPane>