<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acard.acard.ui.AiGridView"
      spacing="0"
      style="-fx-background-color: #1F1F1F;">
    
    <!-- 网格区域 -->
    <ScrollPane fx:id="scroll"
                VBox.vgrow="ALWAYS"
                fitToWidth="true"
                fitToHeight="true"
                hbarPolicy="NEVER"
                vbarPolicy="NEVER"
                style="-fx-background-color: #1F1F1F; -fx-background: #1F1F1F; -fx-border-color: transparent;">
        <GridPane fx:id="grid"
                  style="-fx-background-color: #1F1F1F; -fx-padding: 2;"
                  hgap="2"
                  vgap="2" />
    </ScrollPane>
</VBox>

