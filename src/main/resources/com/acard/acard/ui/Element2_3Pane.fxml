<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.ComboBox?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acard.acard.ui.Element2_3Controller"
      spacing="8" fillWidth="true"
      style="-fx-background-color: #DDE5ED; -fx-border-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8;">
    <padding>
        <Insets top="8" right="8" bottom="8" left="8" />
    </padding>



    <!-- 操作按钮：开启慢放、抓拍、停止、清空 -->
    <HBox spacing="8" alignment="CENTER" VBox.vgrow="ALWAYS">
        <!-- 按钮1：慢放 (25%) -->
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="btnStartSlow" text="▶ 慢放" onAction="#onStartSlow" 
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #3b82f6; 
                           -fx-text-fill: white; 
                           -fx-padding: 6 10; 
                           -fx-background-radius: 6; 
                           -fx-font-size: 10px;
                           -fx-font-weight: 600;" />
        </HBox>
        
        <!-- 按钮2：抓拍 (25%) -->
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="btnCapture" text="◉ 抓拍" onAction="#onCapture"
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #3b82f6; 
                           -fx-text-fill: white; 
                           -fx-padding: 6 10; 
                           -fx-background-radius: 6; 
                           -fx-font-size: 10px;
                           -fx-font-weight: 600;" />
        </HBox>
        
        <!-- 按钮3：停止 (25%) -->
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="btnStop" text="■ 慢放停止" onAction="#onStop"
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #dc2626; 
                           -fx-text-fill: white; 
                           -fx-padding: 6 10; 
                           -fx-background-radius: 6; 
                           -fx-font-size: 10px;
                           -fx-font-weight: 600;" />
        </HBox>
        
        <!-- 按钮4：清空 (25%) -->
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="btnClear" text="⊗ 慢放清空" onAction="#onClear"
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #3b82f6;
                           -fx-text-fill: white; 
                           -fx-padding: 6 10; 
                           -fx-background-radius: 6; 
                           -fx-font-size: 10px;
                           -fx-font-weight: 600;" />
        </HBox>
    </HBox>

    <!-- 抓拍设置：行列 + 前后张数（合并为一行） -->
    <HBox spacing="8" alignment="CENTER" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px;">
        <Label text="行" />
        <ComboBox fx:id="rowCombo" prefWidth="80" />
        <Label text="列" />
        <ComboBox fx:id="colCombo" prefWidth="80" />
        <Label text="前" />
        <ComboBox fx:id="preCountCombo" prefWidth="80" />
        <Label text="后" />
        <ComboBox fx:id="postCountCombo" prefWidth="80" />
        <Label text="偏移" />
        <ComboBox fx:id="offsetCombo" prefWidth="60" />
    </HBox>


    <!-- ⭐ 实时流抓拍按钮行 -->
    <HBox spacing="8" alignment="CENTER" VBox.vgrow="ALWAYS">

        <!-- 开关：抓拍功能启用/禁用 (33%)
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="5">
            <Label text="抓拍" style="-fx-font-size: 11px; -fx-font-weight: 600;" />
            <CheckBox fx:id="chkCaptureEnabled" selected="true" onAction="#onCaptureToggle"
                      style="-fx-font-size: 11px;"/>
        </HBox> -->

        <!-- 按钮1：实时流抓拍 (33%) -->
        <!--<HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="btnSslCapture" text="◉ 实时流抓拍" onAction="#onSslCapture" 
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #10b981;
                           -fx-text-fill: white;
                           -fx-padding: 6 10;
                           -fx-background-radius: 6;
                           -fx-font-size: 11px;
                           -fx-font-weight: 600;" />
        </HBox>-->

        <!-- 按钮2：抓拍清空 (33%) -->
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="btnCaptureClear" text="⊗ 抓拍清空" onAction="#onCaptureClear" 
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #10b981;
                           -fx-text-fill: white;
                           -fx-padding: 6 10;
                           -fx-background-radius: 6;
                           -fx-font-size: 11px;
                           -fx-font-weight: 600;" />
        </HBox>
    </HBox>

</VBox>