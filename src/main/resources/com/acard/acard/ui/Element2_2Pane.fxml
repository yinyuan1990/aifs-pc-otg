<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acard.acard.ui.Element2_2JpegController"
      spacing="0"
      style="-fx-background-color: #292929; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #292929; -fx-border-width: 2;"
      maxHeight="Infinity"
      maxWidth="Infinity">
    
    <stylesheets>
        <URL value="@combobox-dark.css" />
    </stylesheets>

    <!-- 主内容区域（StackPane 用于切换慢放和AI视图） -->
    <StackPane fx:id="mainContentPane"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: #292929; -fx-background-radius: 8 8 0 0;"
               minHeight="0"
               minWidth="0">
        
        <!-- 慢放视频区域（填满父容器） -->
        <StackPane fx:id="videoContainer"
                   style="-fx-background-color: #292929;"
                   maxWidth="Infinity"
                   maxHeight="Infinity">
            <children>
                <!-- 暂无图片占位 -->
                <Label text="暂无图片" 
                       style="-fx-text-fill: #6b7280; -fx-font-size: 24px; -fx-font-style: italic;"
                       StackPane.alignment="CENTER" />
                <!-- ✅ 拉伸铺满，不保持宽高比 -->
                <ImageView fx:id="imageView" preserveRatio="false" />
            </children>
        </StackPane>
        
        <!-- AI 视图区域（默认隐藏） -->
        <ScrollPane fx:id="aiScroll"
                    visible="false"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="NEVER"
                    style="-fx-background-color: #1F1F1F; -fx-background: #1F1F1F; -fx-border-color: transparent;">
            <GridPane fx:id="aiGrid"
                      style="-fx-background-color: #1F1F1F; -fx-padding: 2;"
                      hgap="2"
                      vgap="2" />
        </ScrollPane>
        
    </StackPane>

    <!-- ========== 底部控制面板区域（StackPane 用于切换） ========== -->
    <StackPane fx:id="bottomControlPane"
               VBox.vgrow="NEVER"
               minHeight="56"
               prefHeight="56"
               maxHeight="56">
        
        <!-- 慢放控制面板 -->
        <HBox fx:id="slowmoControlBar" alignment="CENTER_LEFT"
              style="-fx-background-color: #1F1F1F; -fx-border-color: #292929; -fx-border-width: 2; -fx-background-radius: 0 0 8 8;">
            <padding>
                <Insets left="12" right="12" top="12" bottom="12" />
            </padding>
            <children>
                <!-- 左侧固定区域 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <!-- 播放/暂停按钮 -->
                    <Button fx:id="playPauseButton" text="暂停" 
                            prefWidth="66" minWidth="66" maxWidth="66"
                            prefHeight="32" minHeight="32" maxHeight="32"
                            style="-fx-background-color: #292929; -fx-text-fill: #FAFAFA; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 6 12;" />

                    <!-- 倍速选择 -->
                    <MenuButton fx:id="speedMenuButton" text="1x" 
                                prefWidth="60" minWidth="60" maxWidth="60"
                                prefHeight="32" minHeight="32" maxHeight="32"
                                styleClass="dark-menu-button"
                                style="-fx-background-color: #292929; -fx-background-radius: 8; -fx-font-size: 12px; -fx-text-fill: #FAFAFA;" />
                </HBox>

                <!-- 中间：进度条容器（自适应宽度） -->
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER">
                    <padding>
                        <Insets left="50" right="50" />
                    </padding>
                    <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" 
                            minWidth="30"
                            styleClass="slowmo-slider" />
                </HBox>

                <!-- 右侧固定区域：帧数显示 -->
                <Label fx:id="positionLabel" text="0" 
                       alignment="CENTER_RIGHT"
                       style="-fx-text-fill: #FAFAFA; -fx-font-family: 'PingFang HK'; -fx-font-size: 12px;" />
                <Label text="/" style="-fx-text-fill: #FAFAFA; -fx-font-size: 12px;" />
                <Label fx:id="downloadedLabel" text="0"
                       style="-fx-text-fill: #FAFAFA; -fx-font-family: 'PingFang HK'; -fx-font-size: 12px;" />
            </children>
        </HBox>
        
        <!-- AI 控制面板（默认隐藏） -->
        <HBox fx:id="aiControlBar" alignment="CENTER_LEFT" visible="false"
              style="-fx-background-color: #1F1F1F; -fx-border-color: #292929; -fx-border-width: 2; -fx-background-radius: 0 0 8 8;">
            <padding>
                <Insets left="12" right="12" top="12" bottom="12" />
            </padding>
            <children>
                <!-- 清空按钮 -->
                <Button fx:id="aiClearButton" text="清空"
                        prefWidth="66" minWidth="66" maxWidth="66"
                        prefHeight="32" minHeight="32" maxHeight="32"
                        style="-fx-background-color: #292929; -fx-text-fill: #FAFAFA; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 6 12;">
                    <HBox.margin>
                        <Insets right="16" />
                    </HBox.margin>
                </Button>
                
                <!-- 行标签 -->
                <Label text="行" style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px;" />
                
                <!-- 行数选择 -->
                <MenuButton fx:id="aiRowMenuButton" text="2"
                            prefWidth="50"
                            prefHeight="32" minHeight="32" maxHeight="32"
                            styleClass="dark-menu-button"
                            style="-fx-background-color: #292929; -fx-text-fill: #FAFAFA; -fx-font-size: 12px; -fx-background-radius: 8;">
                    <HBox.margin>
                        <Insets left="8" />
                    </HBox.margin>
                </MenuButton>
                
                <!-- 列标签 -->
                <Label text="列" style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px;">
                    <HBox.margin>
                        <Insets left="16" />
                    </HBox.margin>
                </Label>
                
                <!-- 列数选择 -->
                <MenuButton fx:id="aiColMenuButton" text="3"
                            prefWidth="50"
                            prefHeight="32" minHeight="32" maxHeight="32"
                            styleClass="dark-menu-button"
                            style="-fx-background-color: #292929; -fx-text-fill: #FAFAFA; -fx-font-size: 12px; -fx-background-radius: 8;">
                    <HBox.margin>
                        <Insets left="8" />
                    </HBox.margin>
                </MenuButton>
                
                <!-- 弹性空间 -->
                <Region HBox.hgrow="ALWAYS" />
                
                <!-- 横向/纵向切换按钮 -->
                <Button fx:id="aiLayoutToggleButton" text="横向"
                        prefWidth="66" minWidth="66" maxWidth="66"
                        prefHeight="32" minHeight="32" maxHeight="32"
                        style="-fx-background-color: #292929; -fx-text-fill: #FAFAFA; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 6 12;" />
                
                <!-- 测试按钮 -->
                <Button fx:id="aiTestButton" text="测试"
                        prefWidth="66" minWidth="66" maxWidth="66"
                        prefHeight="32" minHeight="32" maxHeight="32"
                        style="-fx-background-color: #292929; -fx-text-fill: #FAFAFA; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 6 12;">
                    <HBox.margin>
                        <Insets left="10" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </StackPane>
</VBox>
