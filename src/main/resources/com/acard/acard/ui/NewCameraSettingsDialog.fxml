<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.acard.acard.ui.NewCameraSettingsDialogController">
   <top>
      <!-- 标题栏 -->
      <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
         <children>
            <Label text="相机设置" textFill="WHITE" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" text="×" 
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
         <content>
            <GridPane hgap="10.0" vgap="15.0" style="-fx-padding: 20;">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" prefWidth="300.0" />
                  <ColumnConstraints hgrow="NEVER" minWidth="60.0" prefWidth="60.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
                  <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="NEVER" />
               </rowConstraints>
               <children>
                  
                  <!-- 摄像头方向选择 -->
                  <Label text="摄像头方向" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <RadioButton fx:id="backCameraRadio" mnemonicParsing="false" selected="true" text="后置" />
                        <RadioButton fx:id="frontCameraRadio" mnemonicParsing="false" text="前置" />
                     </children>
                  </HBox>
                  
                  <!-- 分辨率 -->
                  <Label text="分辨率" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <ComboBox fx:id="clarityCombo" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <!-- 曝光补偿 -->
                  <Label text="曝光补偿 (-2.0~2.0)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Button fx:id="exposureMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="exposureSlider" max="2.0" min="-2.0" value="0.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="exposurePlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="exposureResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="exposureValue" text="0.00" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  
                  <!-- 焦距 -->
                  <Label text="焦距 (1.0~10.0)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Button fx:id="focusMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="focusSlider" max="10.0" min="1.0" value="1.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="focusPlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="focusResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="focusValue" text="1.00" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                  
                  <!-- 帧率 -->
                  <Label text="帧率 (10~60)" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                     <children>
                        <Button fx:id="fpsMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="fpsSlider" max="60.0" min="10.0" value="30.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="fpsPlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="fpsResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="fpsValue" text="30" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                  
                  <!-- 码率 -->
                  <Label text="码率 (10~100)" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                     <children>
                        <Button fx:id="bitrateMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="bitrateSlider" max="100.0" min="10.0" value="50.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="bitratePlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="bitrateResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="bitrateValue" text="50" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                  
                  <!-- 对焦距离 -->
                  <Label text="对焦距离 (0.0~1.0)" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                     <children>
                        <Button fx:id="focusDistanceMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="focusDistanceSlider" max="1.0" min="0.0" value="0.5" HBox.hgrow="ALWAYS" />
                        <Button fx:id="focusDistancePlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="focusDistanceResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="focusDistanceValue" text="0.50" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                  
                  <!-- 亮度 -->
                  <Label text="亮度 (-1.0~1.0)" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                     <children>
                        <Button fx:id="brightnessMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="brightnessSlider" max="1.0" min="-1.0" value="0.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="brightnessPlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="brightnessResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="brightnessValue" text="0.00" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                  
                  <!-- 饱和度 -->
                  <Label text="饱和度 (0.0~2.0)" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="8">
                     <children>
                        <Button fx:id="saturationMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="saturationSlider" max="2.0" min="0.0" value="1.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="saturationPlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="saturationResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="saturationValue" text="1.00" GridPane.columnIndex="2" GridPane.rowIndex="8" />
                  
                  <!-- 对比度 -->
                  <Label text="对比度 (0.0~4.0)" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="9">
                     <children>
                        <Button fx:id="contrastMinusBtn" mnemonicParsing="false" prefWidth="30.0" text="-" />
                        <Slider fx:id="contrastSlider" max="4.0" min="0.0" value="1.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="contrastPlusBtn" mnemonicParsing="false" prefWidth="30.0" text="+" />
                        <Button fx:id="contrastResetBtn" mnemonicParsing="false" prefWidth="40.0" text="复位" 
                                style="-fx-font-size: 10; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-border-color: #45a049; -fx-border-radius: 3; -fx-background-radius: 3;" />
                     </children>
                  </HBox>
                  <Label fx:id="contrastValue" text="1.00" GridPane.columnIndex="2" GridPane.rowIndex="9" />
                  
               </children>
            </GridPane>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <!-- 底部按钮 -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
         <children>
            <Button fx:id="resetAllButton" mnemonicParsing="false" onAction="#handleResetAll" text="一键还原" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 16;" />
            <Button fx:id="okButton" mnemonicParsing="false" onAction="#handleOk" text="确定" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 16;" />
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="取消" 
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 16;" />
         </children>
      </HBox>
   </bottom>
</BorderPane>