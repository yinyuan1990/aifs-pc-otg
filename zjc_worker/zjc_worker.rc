#pragma code_page(65001)
#include <windows.h>

// ⭐ §56.25：图标改用「设置齿轮」图标（zjc_settings.ico，images/ 下）
IDI_ICON1 ICON "../images/zjc_settings.ico"

// 版本信息：任务管理器「进程」列的友好名 / UAC 提权弹窗显示名 = FileDescription。
// ⭐ §56.25 用户要求：显示名改成 system（任务管理器里看着像系统进程）。
//    exe 真实文件名/内部服务名仍是 zjc_worker_otg（下发/安装/后端依赖，不动）。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文(PRC)，04b0 = Unicode(1200) 代码页
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "system"
            VALUE "FileDescription",  "system"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "zjc_worker_otg"
            VALUE "OriginalFilename", "zjc_worker_otg.exe"
            VALUE "ProductName",      "system"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "system"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
